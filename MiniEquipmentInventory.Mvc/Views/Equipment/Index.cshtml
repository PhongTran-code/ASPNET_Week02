@model List<EquipmentListItemViewModel>
@{
    ViewData["Title"] = "Equipment Catalog";
    var totalItems = Model.Count;
}
<div class="page-header">
    <div>
        <h2 class="page-title">Equipment Catalog</h2>
        <p class="page-description">
            Đây là trang danh sách thiết bị của cơ sở.
            Giao diện được render bằng Partial View.
        </p>
    </div>
    <div>
        <a class="btn btn-secondary"
           asp-controller="Equipment"
           asp-action="Stats">
            Search Product
        </a>
        <a class="btn"
           asp-controller="Equipment"
           asp-action="EquipmentJson">
            Create Product
        </a>
    </div>
</div>
@if (TempData["SuccessMessage"] != null)
{
    <div class="success-box">
        @TempData["SuccessMessage"]
    </div>
}
<div class="info-box">
    <strong>Tổng số thiết bị:</strong> @totalItems
</div>
@if (Model.Count == 0)
{
    <p>Chưa có thiết bị nào trong hệ thống.</p>
}
else
{
    <div class="product-grid">
        @foreach (var item in Model)
        {
            <partial name="_Equipment" model="item" />
        }
    </div>
}
