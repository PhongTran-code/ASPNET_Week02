@model List<EquipmentListItemViewModel>

@{
    ViewData["Title"] = "Equipment Catalog";
    var totalItems = Model.Count;
}

<div class="page-header">
    <div>
        <h2 class="page-title">Equipment Catalog</h2>
        <p class="page-description">
            Đây là trang danh sách thiết bị của cơ sở.
        </p>
    </div>
    <div>
        <a class="btn btn-primary" href="/Equipment/Stats">
            Xem thống kê tồn kho
        </a>
    </div>
</div>

<div class="info-panel">
    <strong>Tổng số thiết bị:</strong> @totalItems
</div>

@if (Model.Count == 0)
{
    <p>Chưa có thiết bị nào trong hệ thống.</p>
}
else
{
    <table class="table table-bordered table-striped align-middle">
        <thead>
            <tr>
                <th>Mã thiết bị</th>
                <th>Tên thiết bị</th>
                <th>Nhóm</th>
                <th>Nhà cung cấp</th>
                <th>Giá bán</th>
                <th>Số lượng</th>
                <th>Giá trị tồn kho</th>
                <th>Trạng thái</th>
                <th>Chi tiết</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.EquipId</td>
                    <td>@item.EquipName</td>
                    <td>@item.EquipCategory</td>
                    <td>@item.EquipSupplier</td>
                    <td>@item.PriceText</td>
                    <td>@item.EquipQuantity</td>
                    <td>@item.InventoryValueText</td>
                    <td>
                        <span class="@item.StockStatusClass">
                            @item.StockStatus
                        </span>
                    </td>
                    <td>
                        <a href="/Equipment/Detail/@item.EquipId">Xem</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<p class="mt-4">
    <a class="btn btn-light" href="/">
        Quay lại trang chủ
    </a>
</p>
