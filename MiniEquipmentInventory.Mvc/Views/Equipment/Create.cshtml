@model EquipmentCreateViewModel

@{
    ViewData["Title"] = "Create Equipment";
}
<div class="page-header">
    <div>
        <h2 class="page-title">Create Equipment</h2>
        <p class="page-description">
            Form POST dùng asp-for để bind dữ liệu vào EquipmentCreateViewModel.
        </p>
    </div>
    <a class="btn btn-light"
       asp-controller="Equipment"
       asp-action="Index">
        Quay lại danh sách
    </a>
</div>
<div class="form-layout">
    <form class="form-box"
          asp-controller="Equipment"
          asp-action="Create"
          method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All"></div>

        <div class="form-group">
            <label asp-for="EquipName">Tên thiết bị</label>
            <input asp-for="EquipName"
                   class="form-control"
                   placeholder="Ví dụ: Smart Projector" />
            <span asp-validation-for="EquipName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="EquipCategory">Danh mục</label>
            <input asp-for="EquipCategory"
                   class="form-control"
                   placeholder="Ví dụ: Projection Equipment" />
            <span asp-validation-for="EquipCategory" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="EquipSupplier">Nhà cung cấp</label>
            <input asp-for="EquipSupplier"
                   class="form-control"
                   placeholder="Ví dụ: Epson Vietnam" />
            <span asp-validation-for="EquipSupplier" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="EquipUnitPrice">Giá bán</label>
            <input asp-for="EquipUnitPrice"
                   class="form-control"
                   placeholder="Ví dụ: 4500000" />
            <span asp-validation-for="EquipUnitPrice" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="EquipQuantity">Số lượng</label>
            <input asp-for="EquipQuantity"
                   class="form-control"
                   placeholder="Ví dụ: 12" />
            <span asp-validation-for="EquipQuantity" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="EquipMinStock">Mức tồn tối thiểu</label>
            <input asp-for="EquipMinStock"
                   class="form-control"
                   placeholder="Ví dụ: 5" />
            <span asp-validation-for="EquipMinStock" class="text-danger"></span>
        </div>

        <button class="btn" type="submit">
            Save Equipment
        </button>
        <a class="btn btn-secondary"
           asp-controller="Equipment"
           asp-action="Index">
            Back to List
        </a>
    </form>
    <div class="info-box">
        <h3>Model Binding từ Form POST</h3>
        <p>
            Khi bấm Save, ASP.NET Core sẽ đọc các input trong form
            và tự map vào property của EquipmentCreateViewModel.
        </p>
        <p>
            Ví dụ input có <strong>asp-for="EquipName"</strong>
            thì dữ liệu sẽ được bind vào property <strong>EquipName</strong>.
        </p>
        <p>
            Nếu tên input không khớp với property, action có thể nhận null
            hoặc giá trị mặc định.
        </p>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
